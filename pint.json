{
    "preset": "laravel",
    "rules": {
        "strict_param": true,
        "declare_strict_types": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "phpdoc_align": false,
        "phpdoc_separation": true,
        "phpdoc_trim": true,
        "single_quote": true,
        "no_empty_statement": false,
        "new_with_parentheses": true
    }
}
